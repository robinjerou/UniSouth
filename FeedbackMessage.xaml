<Window x:Class="EventDrivenProgEnrollmentSystem.FeedbackMessage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EventDrivenProgEnrollmentSystem"
        mc:Ignorable="d"
        Title="FeedbackMessage" Height="250" Width="400" WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True"
        Background="#F5F2FF">
    <Grid>
            <!-- Close button -->
            <Button Content="X"
                    Width="24" Height="24"
                    FontSize="14"
                    FontWeight="Bold"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="Close_Click"
                    ToolTip="Close"
                    Cursor="Hand"/>

            <!-- Main content -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Title -->
                <TextBlock Text="Thank You For Your Feedback"
                           FontFamily="Poppins"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#2D2D2D"
                           TextAlignment="Center"/>

                <!-- Emoji + Stars graphic -->
                <!-- Replace the Source paths with your actual image URIs -->
                <Grid Width="100" Height="100">
                    <Image Source="C:\Users\Robin\Downloads\happy-face.png"
                           Stretch="Uniform"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,-20,0,0">
                       
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

</Window>
