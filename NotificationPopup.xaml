<UserControl x:Class="EventDrivenProgEnrollmentSystem.NotificationPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EventDrivenProgEnrollmentSystem"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border Background="#9854CB" CornerRadius="10" Padding="10" Opacity="0.9">
            <TextBlock x:Name="NotificationText"
                   Text="Notification message"
                   Foreground="White"
                   FontWeight="Bold"
                   FontSize="13"
                   TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
