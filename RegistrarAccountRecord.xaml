<Window x:Class="EventDrivenProgEnrollmentSystem.RegistrarAccountRecord"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EventDrivenProgEnrollmentSystem"
        mc:Ignorable="d"
        Title="RegistrarAccountRecord" Height="500" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <!-- Left Navigation Bar -->
            <ColumnDefinition Width="*"/>
            <!-- Main Content -->
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Bar from Home -->
        <Border Grid.Column="0" Background="#C7B9FF">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="147.54"/>
                    <RowDefinition Height="180"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,20,0,0" Orientation="Vertical" Grid.RowSpan="2">
                   

                    <Button Width="80" Height="80" Background="Transparent" BorderThickness="0"  Cursor="Hand" Click="Button_Click_4">
                        <StackPanel HorizontalAlignment="Center">
                            <Grid Width="50" Height="50">
                                <Ellipse Fill="#9854CB" Height="50" Width="50"/>
                                <Image Source="C:\Users\Robin\Downloads\landmark (1).png" Height="16" Width="26"/>
                            </Grid>
                            <TextBlock Text="Account Record" FontSize="8" Margin="0,6,0,0" HorizontalAlignment="Center" Width="60" TextAlignment="Center" Foreground="#64379F" FontFamily="Inter" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button Width="80" Height="60" Background="Transparent" BorderThickness="0"  Cursor="Hand" Click="Button_Click_5">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="C:\Users\Robin\Downloads\calendar-check.png" Height="16" Width="26"/>
                            <TextBlock Text="Schedule" FontSize="8" Margin="0,4,0,0" HorizontalAlignment="Center" Width="70" TextAlignment="Center" Foreground="#64379F" FontFamily="Inter" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button Width="80" Height="60" Background="Transparent" BorderThickness="0"  Cursor="Hand" Click="Button_Click_6">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="C:\Users\Robin\Downloads\book-user.png" Height="16" Width="26"/>
                            <TextBlock Text="Students" FontSize="8" Margin="0,4,0,0" HorizontalAlignment="Center" Width="60" TextAlignment="Center" Foreground="#64379F" FontFamily="Inter" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button Width="80" Height="60" Background="Transparent" BorderThickness="0"  Cursor="Hand" Click="Button_Click_7">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="C:\Users\Robin\Downloads\folder-closed.png" Height="16" Width="26"/>
                            <TextBlock Text="Subject" FontSize="8" Margin="0,4,0,0" HorizontalAlignment="Center" Width="60" TextAlignment="Center" Foreground="#64379F" FontFamily="Inter" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button Width="80" Height="60" Background="Transparent" BorderThickness="0"  Cursor="Hand">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="C:\Users\Robin\Downloads\settings.png" Height="16" Width="26"/>
                            <TextBlock Text="Settings" FontSize="8" Margin="0,4,0,0" HorizontalAlignment="Center" Width="60" TextAlignment="Center" Foreground="#64379F" FontFamily="Inter" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1">
                
            <Rectangle Height="57" Margin="0,0,0,0"  VerticalAlignment="Top" Fill="#9854CB"/>
            <TextBlock Text=" Registar Account Record" FontFamily="Poppins" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,20" Foreground="White"/>
            <Rectangle Height="316" Stroke="#FF281E58" VerticalAlignment="Top" Width="680" Fill="#FFDDD3E6" Margin="20,90,0,0" HorizontalAlignment="Left"/>

            <ListView x:Name="lstRecords" Margin="30,133,27,0" Height="250" FontSize="8" VerticalAlignment="Top" SelectionChanged="lstRecords_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="School Year" Width="100" DisplayMemberBinding="{Binding SchoolYear}" />
                        <GridViewColumn Header="Description" Width="150" DisplayMemberBinding="{Binding Description}" />
                        <GridViewColumn Header="Amount" Width="150" DisplayMemberBinding="{Binding Amount}" />
                        <GridViewColumn Header="Balance" Width="150" DisplayMemberBinding="{Binding Balance}" />
                        <GridViewColumn Header="Status" Width="80" DisplayMemberBinding="{Binding Status}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <Button x:Name="btnAddRecord" Content="Add Record" Margin="30,94,0,0" VerticalAlignment="Top" Background="#9854CB" Foreground="White" BorderBrush="Transparent" BorderThickness="1" Height="36" Width="134" FontWeight="Bold" Click="btnAddRecord_Click" HorizontalAlignment="Left" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="23">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="btnUpdateRecord" Content="Update Record" Margin="175,94,0,0" VerticalAlignment="Top" Background="#9854CB" Foreground="White" BorderBrush="Transparent" BorderThickness="1" Height="36" Width="134" FontWeight="Bold" Click="btnUpdateRecord_Click" HorizontalAlignment="Left" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="23">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel HorizontalAlignment="Right" Margin="0,94,27,0" VerticalAlignment="Top" Width="250">
                <Border CornerRadius="20" Background="#FAF9FF" Height="36">
                    <Grid>
                        <TextBox x:Name="txtSearch" Background="Transparent" BorderThickness="0" Margin="12,0,32,0" VerticalContentAlignment="Center" Foreground="Gray" FontSize="12" FontFamily="Segoe UI" Text="" TextChanged="txtSearch_TextChanged"/>
                        <Image Source="C:\Users\Robin\Downloads\search.png" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    </Grid>
                </Border>
                <ListBox x:Name="lstSuggestions" Visibility="Collapsed" Height="100" Background="White" BorderThickness="1" BorderBrush="LightGray" SelectionChanged="lstSuggestions_SelectionChanged" DisplayMemberPath="FullName"/>
            </StackPanel>

            <!-- School Year -->
            <TextBlock Text="School Year" Margin="20,415,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Border Margin="20,433,0,0" Width="120" VerticalAlignment="Top" HorizontalAlignment="Left" CornerRadius="8" Background="White" BorderBrush="LightGray" BorderThickness="1">
                <TextBox x:Name="txtSchoolYear" Background="Transparent" BorderThickness="0" Padding="6,2"/>
            </Border>

            <!-- Description -->
            <TextBlock Text="Description" Margin="150,415,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Border Margin="150,433,0,0" Width="120" VerticalAlignment="Top" HorizontalAlignment="Left" CornerRadius="8" Background="White" BorderBrush="LightGray" BorderThickness="1">
                <TextBox x:Name="txtDescription" Background="Transparent" BorderThickness="0" Padding="6,2"/>
            </Border>

            <!-- Amount -->
            <TextBlock Text="Amount" Margin="280,415,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Border Margin="280,433,0,0" Width="120" VerticalAlignment="Top" HorizontalAlignment="Left" CornerRadius="8" Background="White" BorderBrush="LightGray" BorderThickness="1">
                <TextBox x:Name="txtAmount" Background="Transparent" BorderThickness="0" Padding="6,2"/>
            </Border>

            <!-- Balance -->
            <TextBlock Text="Balance" Margin="410,415,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Border Margin="410,433,0,0" Width="120" VerticalAlignment="Top" HorizontalAlignment="Left" CornerRadius="8" Background="White" BorderBrush="LightGray" BorderThickness="1">
                <TextBox x:Name="txtBalance" Background="Transparent" BorderThickness="0" Padding="6,2"/>
            </Border>

            <!-- Status -->
            <TextBlock Text="Status" Margin="540,415,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Border Margin="540,433,0,0" Width="120" VerticalAlignment="Top" HorizontalAlignment="Left" CornerRadius="8" Background="White" BorderBrush="LightGray" BorderThickness="1">
                <TextBox x:Name="txtStatus" Background="Transparent" BorderThickness="0" Padding="6,2"/>
            </Border>
        </Grid>
    </Grid>
</Window>
