<Window x:Class="EventDrivenProgEnrollmentSystem.Ticket"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EventDrivenProgEnrollmentSystem"
        mc:Ignorable="d"
        Title="Ticket" Height="550" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>
        
        

       

        <!--Navigation Bar-->
        <Border Grid.Column="0" Background="#C7B9FF" CornerRadius="0,20,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="147.54"/>
                    <RowDefinition Height="180"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>



                <StackPanel Grid.Row="0"  HorizontalAlignment="Center" Margin="0,20,0,0" Orientation="Vertical" Grid.RowSpan="2">
                    <!-- Home -->
                    <Button Width="80" Height="60"  Background="Transparent" BorderThickness="0"  Click="Nav_Home_Click" Cursor="Hand">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="C:\Users\Robin\Downloads\house.png" Height="16" Width="26" />
                            <TextBlock Text="Home" FontSize="8" Margin="0,6,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"  Width="60"  TextAlignment="Center" Foreground="#64379F" FontFamily="Poppins" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- Academic Record -->
                    <Button Width="80" Height="60" Background="Transparent" BorderThickness="0" Click="Nav_AcademicRecord_Click" Cursor="Hand">
                        <StackPanel HorizontalAlignment="Center">
                            <Image Source="C:\Users\Robin\Downloads\circle-check.png" Height="16" Width="26"/>
                            <TextBlock Text="Academic Record" FontSize="8" Margin="0,4,0,0" HorizontalAlignment="Center" Width="70"  TextAlignment="Center" Foreground="#64379F" FontFamily="Poppins" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- Account Record -->
                    <Button Width="80" Height="60" Background="Transparent" BorderThickness="0" Click="Nav_AccountRecord_Click" Cursor="Hand">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="C:\Users\Robin\Downloads\landmark.png" Height="16" Width="26"/>
                            <TextBlock Text="Account Record" FontSize="8" Margin="0,4,0,0" HorizontalAlignment="Center"  TextWrapping="Wrap" Width="60"  TextAlignment="Center" Foreground="#64379F" FontFamily="Poppins" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- Concerns -->
                    <Button Width="80" Height="70"  Background="Transparent" BorderThickness="0"  Click="Nav_Concerns_Click" Cursor="Hand">
                        <StackPanel HorizontalAlignment="Center">
                            <Grid Width="50" Height="50">
                                <Ellipse Fill="#9854CB" Height="50" Width="50"/>
                                <Image Source="C:\Users\Robin\Downloads\handshake (1).png" Height="16" Width="26"/>
                            </Grid>
                            <TextBlock Text="Concerns" FontSize="8" Margin="0,4,0,0" HorizontalAlignment="Center"  TextWrapping="Wrap"  Width="60"  TextAlignment="Center" Foreground="#64379F" FontFamily="Poppins" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- Settings -->
                    <Button Width="80" Height="60" Background="Transparent" BorderThickness="0" Click="Nav_Settings_Click" Cursor="Hand">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="C:\Users\Robin\Downloads\settings.png" Height="16" Width="26"/>
                            <TextBlock Text="Settings" FontSize="8" Margin="0,4,0,0" HorizontalAlignment="Center"  TextWrapping="Wrap"  Width="60"  TextAlignment="Center" Foreground="#64379F" FontFamily="Poppins" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- “Need Help?” button pinned to bottom -->
                <Button Grid.Row="3" Content="Need Help?" Width="70" Height="25" Background="#E1D2FF" Foreground="#64379F" FontFamily="Poppins" FontSize="8" FontWeight="Bold" BorderBrush="Transparent" HorizontalAlignment="Center" Margin="0,0,0,16" Click="Help_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="16" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" Padding="16" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--Header-->
                <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="1" Background="#FCFBFF" CornerRadius="12" Margin="16,16,16,0" Padding="16" Height="120">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- title + underline -->
                            <RowDefinition Height="Auto"/>
                            <!-- pill button -->
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <!-- title/underline column -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- logo column -->
                        </Grid.ColumnDefinitions>

                        <!-- Title + underline -->
                        <Grid Grid.Row="0" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="UniSouth School" FontFamily="Poppins" FontSize="28" FontWeight="SemiBold"/>
                        </Grid>

                        <!-- “Today's schedule” pill -->
                        <Grid Grid.Row="1" Grid.Column="0" Width="100" Height="25" HorizontalAlignment="Left">
                            <Rectangle Fill="#9854CB" RadiusX="8" RadiusY="8"/>
                            <TextBlock Text="User Ticket" Foreground="White" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>


                        <!-- Circular logo (overlapping) -->
                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="200" Height="100" CornerRadius="50" HorizontalAlignment="Right"  Margin="0,-30,-30,0">
                            <!-- negative top/right to overlap -->
                            <Image Source="C:\Users\Robin\Downloads\unisouthlogo.png" Width="200" Height="100" HorizontalAlignment="Left" VerticalAlignment="Center" StretchDirection="DownOnly" />
                        </Border>
                    </Grid>
                </Border>


                <Grid Grid.Column="1" Grid.Row="1" Margin="16">
                    <Rectangle Fill="#F5F2FF" Stroke="Black" StrokeThickness="1" RadiusX="12" RadiusY="12" Height="360"></Rectangle>

                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Title -->
                            <RowDefinition Height="Auto"/>
                            <!-- Inputs -->
                            <RowDefinition Height="Auto"/>
                            <!-- Description label -->
                            <RowDefinition Height="Auto"/>
                            <!-- Description box -->
                            <RowDefinition Height="19*"/>
                            <RowDefinition Height="158*"/>
                            <!-- Spacer -->
                            <RowDefinition Height="Auto"/>
                            <!-- Send button -->
                        </Grid.RowDefinitions>

                        <TextBlock Text="Submit Encountered Issue" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>


                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="First Name" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtFirstName" Height="28" BorderBrush="{x:Null}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Last Name" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtLastName" Height="28" BorderBrush="{x:Null}"/>
                            </StackPanel>

                            <!-- Email -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Email" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtEmail" Height="28" BorderBrush="{x:Null}"/>
                            </StackPanel>

                            <!-- Date -->
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Date" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtDate" Height="28" BorderBrush="{x:Null}"/>
                            </StackPanel>


                        </Grid>

                        <TextBlock Grid.Row="2"  Text="Description of the Problem"  FontSize="12" Margin="0,0,0,4"/>

                        <!-- 4) Description Box -->
                        <TextBox x:Name="txtDescription" Grid.Row="3"   Height="100"  AcceptsReturn="True"  TextWrapping="Wrap" BorderBrush="{x:Null}"/>


                    </Grid>

                    <Button Grid.Row="4" Content="Send Support Ticket"  Width="140" Height="40" Padding="12,8" Background="#9854CB" Foreground="White" BorderThickness="0" HorizontalAlignment="Center" Margin="0,300,0,0" Click="SupportButton_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="8" 
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Margin="{TemplateBinding Padding}" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </Grid>

            </StackPanel>

        </ScrollViewer>

       
        <!--Right Column-->
        <Border Grid.Column="2" Background="#F5F2FF" CornerRadius="12" Margin="16" Height="320" Width="180">
            <StackPanel Margin="16">

                <!-- Illustration -->
                <Image Source="C:\Users\Robin\Downloads\mandesk.png" Height="120" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <!-- Contact Header -->
                <TextBlock Text="Contact the school email for Inquiries" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" FontFamily="Poppins"/>
                <TextBlock Text="Send us a message at unisouth@gmail.com" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" FontFamily="Poppins" FontWeight="Light"/>

                <!-- Announcements Button -->
                <Button Width="150" Height="32" HorizontalAlignment="Center" Margin="0,0,0,20" Background="#5551FF" Click="SocialMediaButton_Click" Cursor="Hand" >
                    <TextBlock Text="Check our Social Media Pages for Announcements" FontSize="10" Foreground="White" FontWeight="Bold"  TextWrapping="Wrap" TextAlignment="Center"/>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Border>

       

    </Grid>
</Window>
