<Window x:Class="EventDrivenProgEnrollmentSystem.MessageEmail"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EventDrivenProgEnrollmentSystem"
        mc:Ignorable="d"
        Title="MessageEmail" Height="400" Width="600" 
        WindowStartupLocation="CenterScreen" Background="#F5F2FF">
    <Grid>
        <Border Width="70" Height="40" CornerRadius="8" Background="#5551FF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0">
            <Button Click="BackButton_Click" Cursor="Hand" BorderThickness="0" Background="Transparent" Focusable="False">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>

                <Image Source="C:\Users\Robin\Downloads\undo-2 (1).png" Width="20" Height="20" Stretch="Uniform"/>
            </Button>
        </Border>


        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Title -->
            <TextBlock Text="Please Wait and Check Your Email for the Confirmation" FontFamily="Poppins"  FontSize="36" FontWeight="SemiBold" Foreground="#2D2D2D" TextAlignment="Center" TextWrapping="Wrap" Width="500"/>

            <!-- Emoji + Stars graphic -->
            <!-- Replace the Source paths with your actual image URIs -->
            <Grid Width="120" Height="120">
                <Image Source="C:\Users\Robin\Downloads\messageanimation.gif"
               Stretch="Uniform"/>
                <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,-20,0,0">

                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Enter Student ID" FontSize="14" VerticalAlignment="Center"  Margin="0,0,8,0" FontFamily="Inter" FontWeight="SemiBold"/>
                <TextBox x:Name="txtStudentID" Width="300" Height="30"   FontSize="14" BorderBrush="{x:Null}"  BorderThickness="1" Background="White" />
            </StackPanel>

            <Button Content="Confirm" Width="100" Height="30" Margin="0,10,0,0" Click="btnConfirm_Click"
        Background="#5551FF" Foreground="White" BorderBrush="Transparent" FontWeight="Bold" HorizontalAlignment="Center"/>
        </StackPanel>

    </Grid>
</Window>
