<Window x:Class="EventDrivenProgEnrollmentSystem.RegistrarSchedule"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EventDrivenProgEnrollmentSystem"
        mc:Ignorable="d"
        Title="RegistrarSchedule" Height="500" Width="800">
    <Grid>
        <Rectangle HorizontalAlignment="Left" Height="434" Stroke="Black" VerticalAlignment="Center" Width="106" Fill="#FFB484E2"/>
        <Image Source="C:\Users\Robin\Downloads\unisouthlogo.png" Stretch="Uniform" Margin="-34,8,660,352" RenderTransformOrigin="0.414,0.488"/>
        <Rectangle Height="57" Margin="106,0,0,0" Stroke="Black" VerticalAlignment="Top" Fill="#FF5E2C8E"/>

        <TextBlock  HorizontalAlignment="Left" Margin="145,62,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Text="Name:" FontWeight="Bold"/>
        <TextBlock  HorizontalAlignment="Left" Margin="145,82,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Text="Student Number:" FontWeight="Bold"/>
        <TextBlock  HorizontalAlignment="Left" Margin="145,103,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Text="Course and Year:" FontWeight="Bold"/>

        <TextBlock x:Name="txtStudentNumber" HorizontalAlignment="Left" Margin="250,82,0,0" TextWrapping="Wrap" VerticalAlignment="Top"  Width="150"/>
        <TextBlock x:Name="txtName" HorizontalAlignment="Left" Margin="187,62,0,0" TextWrapping="Wrap" VerticalAlignment="Top"   Width="500"/>
        <TextBlock x:Name="txtCourseYear" HorizontalAlignment="Center" Margin="0,103,0,0" TextWrapping="Wrap" VerticalAlignment="Top"  Width="300"/>


        <!-- Button with avatar image -->
        <Button HorizontalAlignment="Left" Margin="596,0,0,0" VerticalAlignment="Top" Width="204" Height="57" Background="#FF27104E">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="C:\Users\Robin\Downloads\unisouthlogo.png" Width="55" Height="40"/>
                <TextBlock Foreground="White"><Run Text="JOHN DOE"/><LineBreak/><Run Text="REGISTRAR"/><LineBreak/></TextBlock>
            </StackPanel>
        </Button>

        <Rectangle HorizontalAlignment="Left" Height="184" Stroke="#FF281E58" VerticalAlignment="Top" Width="659" Fill="#FFDDD3E6" Margin="125,124,0,0"/>
        <!--<TextBox HorizontalAlignment="Left" Margin="578,106,0,0" TextWrapping="Wrap" Text="Search..." VerticalAlignment="Top" Width="168" SelectionChanged="lstSubjects_SelectionChanged"/>-->
        <ListView x:Name="lstSubjects" Margin="136,133,27,0" Height="159" FontSize="8" VerticalAlignment="Top">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Subject" Width="150" DisplayMemberBinding="{Binding Subject}" />
                    <GridViewColumn Header="Unit" Width="160" DisplayMemberBinding="{Binding Unit}" />
                    <GridViewColumn Header="Lab" Width="150" DisplayMemberBinding="{Binding Lab}" />
                    <GridViewColumn Header="Time" Width="150" DisplayMemberBinding="{Binding Time}" />
                    <GridViewColumn Header="Day" Width="150" DisplayMemberBinding="{Binding Day}"/>
                </GridView>
            </ListView.View>
        </ListView>



        <ComboBox x:Name="ListSubjectsComboBox" Width="659" Padding="20,0" Background="Transparent" HorizontalAlignment="Left" Margin="125,313,0,130"  DisplayMemberPath="Subject"
          SelectedValuePath="SubjectID"  SelectionChanged="ListSubjectsComboBox_SelectionChanged" >

        </ComboBox>


    </Grid>
</Window>
