<Window x:Class="EventDrivenProgEnrollmentSystem.Card"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EventDrivenProgEnrollmentSystem"
        mc:Ignorable="d"
        Title="Card" Height="550" Width="800" Background="#F6F6FA"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
    <!-- style for those little white cards -->
    <Style x:Key="PaymentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#DDD"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!--Header-->
        <Border Grid.Row="0" Background="#C7B9FF">
            <StackPanel Orientation="Horizontal"  VerticalAlignment="Center" Margin="2,0">
                <Image Source="C:\Users\Robin\Downloads\unisouthlogo.png" Height="80" Width="80" Stretch="Uniform"/>
                <TextBlock Text="UniSouth" FontSize="25" FontWeight="Bold" Foreground="#2D2D2D" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,20,0"></TextBlock>
            </StackPanel>
        </Border>




        <StackPanel Grid.Row="1" Margin="40,20,40,20">
            <Grid>
                <!-- Title + underline -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Tuition Fee - Send to: UniSouth " FontSize="28" VerticalAlignment="Center"/>
                    <Rectangle Height="1" Fill="#888" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- “Return Back” button aligned to right -->
                <Button Grid.Column="1" Content="Return Back" Background="#9854CB" Foreground="White" Padding="12,6" Margin="0,0,0,4" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="0" Click="ReturnButton_Click"/>
            </Grid>

            <TextBlock Text="Payment Plan" FontSize="14" Margin="0,15,0,4"/>
            <ComboBox x:Name="PaymentOptionsComboBox" Width="400" Height="40" Padding="8,0" Background="Transparent" HorizontalAlignment="Left" >
                <ComboBoxItem Content="Plan A - 80000 Pesos, 0 Balance"/>
                <ComboBoxItem Content="Plan B - 50000 Pesos, 30000 Balance"/>
                <ComboBoxItem Content="Plan C - 30000 Pesos Initial, 10,0000 Pesos Montly"/>
            </ComboBox>


            <TextBlock Text="Name" FontSize="14" Margin="0,20,0,4"/>
            <TextBox Width="400" Height="30" Padding="4" BorderBrush="{x:Null}" BorderThickness="1" Margin="0,0,0,16" HorizontalAlignment="Left"/>

            <TextBlock Text="Card Details" FontSize="14" Margin="0,0,0,4"/>
            <TextBox Width="400" Height="30" Padding="4" BorderBrush="{x:Null}" BorderThickness="1" Margin="0,0,0,16" HorizontalAlignment="Left"/>

            <!--<ComboBox x:Name="PaymentOptionsComboBox" Width="400" Height="40" Padding="8,0" Background="Transparent" HorizontalAlignment="Left" SelectionChanged="PaymentOptionsComboBox_SelectionChanged">
                <ComboBoxItem Content="Card"/>
                <ComboBoxItem Content="Mobile"/>
            </ComboBox>-->


            <TextBlock Text="Send to" FontSize="14" Margin="0,0,0,4"/>
            <TextBox Width="400" Height="30" Padding="4" BorderBrush="{x:Null}" BorderThickness="1" Margin="0,0,0,16" HorizontalAlignment="Left"/>

            <!--<TextBlock Text="Amount" FontSize="14" Margin="0,0,0,4"/>
            <TextBox Width="400" Height="30" Padding="4" BorderBrush="{x:Null}" BorderThickness="1" Margin="0,0,0,16" HorizontalAlignment="Left"/>-->
           


            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                    <Button Style="{StaticResource PaymentButtonStyle}"/>
                    <Button Style="{StaticResource PaymentButtonStyle}"/>
                    <Button Style="{StaticResource PaymentButtonStyle}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Send For Confirmation" Background="#9854CB" Foreground="White" Padding="12,12" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="0"/>
            </Grid>
           
        </StackPanel>
        


      
    </Grid>
</Window>
