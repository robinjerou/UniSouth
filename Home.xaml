<Window x:Class="EventDrivenProgEnrollmentSystem.Home"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EventDrivenProgEnrollmentSystem"
        mc:Ignorable="d"
        Title="Home" Height="550" Width="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- … your other resources … -->
        <Style x:Key="StarToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#757575"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Content" Value="★"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover background -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#D3D3D3"/>
                                <!-- light gray background -->
                            </Trigger>
                            <!-- Checked (selected) star color -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="Gold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>



        <Border Grid.Column="3" Background="#FCFBFF"/>



        <Border Grid.Column="0" Background="#C7B9FF" CornerRadius="0,20,0,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="147.54"/>
                    <RowDefinition Height="180"/>
                    <!-- icons -->
                    <RowDefinition Height="*"/>
                    <!-- spacer -->
                    <RowDefinition Height="Auto"/>
                    <!-- help button -->
                </Grid.RowDefinitions>



                <StackPanel Grid.Row="0"  HorizontalAlignment="Center" Margin="0,20,0,0" Orientation="Vertical" Grid.RowSpan="2">
                    <!-- Home -->
                    <Button Width="80" Height="70"  Background="Transparent" BorderThickness="0"  Click="Nav_Home_Click" Cursor="Hand">
                        <StackPanel  HorizontalAlignment="Center">
                            <Grid Width="50" Height="50">
                                <Ellipse Fill="#9854CB" Height="50" Width="50"/>
                                <Image Source="C:\Users\Robin\Downloads\house (1).png" Height="16" Width="26" />
                            </Grid>
                            <TextBlock Text="Home" FontSize="8" Margin="0,6,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"  Width="60"  TextAlignment="Center" Foreground="#64379F" FontFamily="Inter" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- Academic Record -->
                    <Button Width="80" Height="60" Background="Transparent" BorderThickness="0" Click="Nav_AcademicRecord_Click" Cursor="Hand" >
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="C:\Users\Robin\Downloads\circle-check.png" Height="16" Width="26"/>
                            <TextBlock Text="Academic Record" FontSize="8" Margin="0,4,0,0" HorizontalAlignment="Center" Width="70"  TextAlignment="Center" Foreground="#64379F" FontFamily="Inter" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- Account Record -->
                    <Button Width="80" Height="60" Background="Transparent" BorderThickness="0" Click="Nav_AccountRecord_Click" Cursor="Hand" >
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="C:\Users\Robin\Downloads\landmark.png" Height="16" Width="26"/>
                            <TextBlock Text="Account Record" FontSize="8" Margin="0,4,0,0" HorizontalAlignment="Center"  TextWrapping="Wrap" Width="60"  TextAlignment="Center" Foreground="#64379F" FontFamily="Inter" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- Concerns -->
                    <Button Width="80" Height="60"  Background="Transparent" BorderThickness="0"  Click="Nav_Concerns_Click" Cursor="Hand" >
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="C:\Users\Robin\Downloads\handshake.png" Height="16" Width="26"/>
                            <TextBlock Text="Concerns" FontSize="8" Margin="0,4,0,0" HorizontalAlignment="Center"  TextWrapping="Wrap"  Width="60"  TextAlignment="Center" Foreground="#64379F" FontFamily="Inter" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- Settings -->
                    <Button Width="80" Height="60" Background="Transparent" BorderThickness="0" Click="Nav_Settings_Click" Cursor="Hand">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="C:\Users\Robin\Downloads\settings.png" Height="16" Width="26"/>
                            <TextBlock Text="Settings" FontSize="8" Margin="0,4,0,0" HorizontalAlignment="Center"  TextWrapping="Wrap"  Width="60"  TextAlignment="Center" Foreground="#64379F" FontFamily="Inter" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>


                <!-- “Need Help?” button pinned to bottom -->
                <Button Grid.Row="3" Content="Need Help?" Width="70" Height="25" Background="#E1D2FF" Foreground="#64379F" FontFamily="Inter" FontSize="8" FontWeight="Bold" BorderBrush="Transparent" HorizontalAlignment="Center" Margin="0,0,0,16" Click="Help_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" CornerRadius="16" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                </Button>
            </Grid>


        </Border>


        <!--<StackPanel Grid.Column="1">
            -->
        <!--Middle-->
        <!--
            <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="1" Background="#FCFBFF" CornerRadius="12" Margin="16,16,16,250" Padding="16" Height="120">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        -->
        <!-- title + underline -->
        <!--
                        <RowDefinition Height="Auto"/>
                        -->
        <!-- pill button -->
        <!--
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        -->
        <!-- title/underline column -->
        <!--
                        <ColumnDefinition Width="Auto"/>
                        -->
        <!-- logo column -->
        <!--
                    </Grid.ColumnDefinitions>

                    -->
        <!-- Title + underline -->
        <!--
                    <Grid Grid.Row="0" Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="UniSouth School" FontFamily="Poppins" FontSize="28" FontWeight="SemiBold"/>
                    </Grid>

                    -->
        <!-- “Today's schedule” pill -->
        <!--
                    <Grid Grid.Row="1" Grid.Column="0" Width="100" Height="25" HorizontalAlignment="Left">

                        -->
        <!-- the colored pill -->
        <!--
                        <Rectangle Fill="#9854CB" RadiusX="8" RadiusY="8"/>

                        -->
        <!-- the centered text -->
        <!--
                        <TextBlock Text="Schedule" Foreground="White" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>


                    -->
        <!-- Circular logo (overlapping) -->
        <!--
                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="200" Height="100" CornerRadius="50" HorizontalAlignment="Right"  Margin="0,-30,-30,0">
                        -->
        <!-- negative top/right to overlap -->
        <!--
                        <Image Source="C:\Users\Robin\Downloads\unisouthlogo.png" Width="200" Height="100" HorizontalAlignment="Left" VerticalAlignment="Center" StretchDirection="DownOnly" />
                    </Border>
                </Grid>
            </Border>

        </StackPanel>-->

        <!--Right Column-->
        <Border Grid.Column="2"
            Background="#E1D2FF"
            CornerRadius="12"
             Margin="16"
        VerticalAlignment="Stretch">
            <StackPanel Margin="16">

                <!-- Avatar + Name -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ellipseHomeProfile" Width="40" Height="40" Fill="LightGray"/>
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock x:Name="txtStudentName" Text="Student Name"
                       FontSize="14"
                       FontWeight="Bold"/>
                        <TextBlock Text="Student"
                       FontSize="12"
                       Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Separator -->
                <Rectangle Height="1" Fill="#888" Margin="0,8,0,8"/>

                <!-- Illustration -->
                <Image Source="C:\Users\Robin\Downloads\mandesk.png"
               Height="120"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               Margin="0,0,0,12"/>

                <!-- Contact Header -->
                <TextBlock Text="Contact the school email for Inquiries" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" FontFamily="Poppins"/>
                <TextBlock Text="Send us a message at unisouth@gmail.com" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" FontFamily="Inter" FontWeight="Light"/>

                <!-- Announcements Button -->
                <Button Width="180" Height="50" HorizontalAlignment="Center" Margin="0,0,0,20" Background="#5551FF" Click="SocialMediaButton_Click" Cursor="Hand">
                    <TextBlock Text="Check our Social Media Pages for Announcements" FontSize="12" Foreground="White" FontWeight="SemiBold"  TextWrapping="Wrap" TextAlignment="Center"/>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBlock Text="Rate the System" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,4" FontFamily="Poppins"/>
                <!-- Rate the System -->
                <StackPanel x:Name="StarsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10" >
                    <ToggleButton Style="{StaticResource StarToggleButtonStyle}" Tag="1" Click="Star_Click" Cursor="Hand"/>
                    <ToggleButton Style="{StaticResource StarToggleButtonStyle}" Tag="2" Click="Star_Click" Cursor="Hand"/>
                    <ToggleButton Style="{StaticResource StarToggleButtonStyle}" Tag="3" Click="Star_Click" Cursor="Hand"/>
                    <ToggleButton Style="{StaticResource StarToggleButtonStyle}" Tag="4" Click="Star_Click" Cursor="Hand"/>
                    <ToggleButton Style="{StaticResource StarToggleButtonStyle}" Tag="5" Click="Star_Click" Cursor="Hand"/>
                </StackPanel>

                <!-- Send Feedback -->
                <Button Content="Send Feedback" Width="140" Height="32" HorizontalAlignment="Center" Background="#DDACF5" Foreground="#64379F" FontWeight="Bold" Click="SendButton_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" CornerRadius="16" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <!-- Schedule Card -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- header card -->
                <RowDefinition Height="*"/>
                <!-- schedule card -->
            </Grid.RowDefinitions>

            <!-- Header Card -->
            <Border Grid.Row="0" Background="#FCFBFF" CornerRadius="12" Margin="16,16,16,8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="UniSouth School" FontFamily="Poppins" FontSize="28" FontWeight="SemiBold"/>
                    </Grid>

                    <Grid Grid.Row="1" Grid.Column="0" Width="100" Height="25" HorizontalAlignment="Left">
                        <Rectangle Fill="#9854CB" RadiusX="8" RadiusY="8"/>
                        <TextBlock Text="Schedule" Foreground="White" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>

                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="200" Height="100" CornerRadius="50" HorizontalAlignment="Right"  Margin="0,-30,-30,0">
                        <Image Source="C:\Users\Robin\Downloads\unisouthlogo.png" Width="200" Height="100" HorizontalAlignment="Left" VerticalAlignment="Center" StretchDirection="DownOnly" />
                    </Border>
                </Grid>
            </Border>

            <!-- Schedule Card -->
            <Grid Grid.Column="1" Grid.Row="1" Margin="16,0,16,16">
                <!-- Background Rectangle -->
                <Rectangle Fill="#F8F7FF" RadiusX="12" RadiusY="12" Stroke="Black" StrokeThickness="1"/>

                <!-- Schedule Content -->
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Day Headers -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#D3D3D3">
                            <TextBlock Text="Monday" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Border>
                        <Border Grid.Column="1" Background="#D3D3D3">
                            <TextBlock Text="Tuesday" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Border>
                        <Border Grid.Column="2" Background="#D3D3D3">
                            <TextBlock Text="Wednesday" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Border>
                        <Border Grid.Column="3" Background="#D3D3D3">
                            <TextBlock Text="Thursday" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Border>
                        <Border Grid.Column="4" Background="#D3D3D3">
                            <TextBlock Text="Friday" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Border>
                        <Border Grid.Column="5" Background="#D3D3D3">
                            <TextBlock Text="Saturday" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <!-- Schedule Canvas Blocks -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Height="720">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Canvas x:Name="canvasMonday"    Grid.Column="0" Background="#F9F9FF"/>
                            <Canvas x:Name="canvasTuesday"   Grid.Column="1" Background="#F9F9FF"/>
                            <Canvas x:Name="canvasWednesday" Grid.Column="2" Background="#F9F9FF"/>
                            <Canvas x:Name="canvasThursday"  Grid.Column="3" Background="#F9F9FF"/>
                            <Canvas x:Name="canvasFriday"    Grid.Column="4" Background="#F9F9FF"/>
                            <Canvas x:Name="canvasSaturday"  Grid.Column="5" Background="#F9F9FF"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

    </Grid>

</Window>   
