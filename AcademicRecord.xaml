<Window x:Class="EventDrivenProgEnrollmentSystem.AcademicRecord"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EventDrivenProgEnrollmentSystem"
        mc:Ignorable="d"
        Title="AcademicRecord" Height="550" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!--Add monday tuesday daily in schedule-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <!--Navigation Bar-->
        <Border Grid.Column="0" Background="#C7B9FF" CornerRadius="0,20,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="147.54"/>
                    <RowDefinition Height="180"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <StackPanel Grid.Row="0"  HorizontalAlignment="Center" Margin="0,20,0,0" Orientation="Vertical" Grid.RowSpan="2">
                    <!-- Home -->
                    <Button Width="80" Height="70"  Background="Transparent" BorderThickness="0" Click="Nav_Home_Click" Cursor="Hand">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="C:\Users\Robin\Downloads\house.png" Height="16" Width="26"/>
                            <TextBlock Text="Home" FontSize="8" Margin="0,6,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"  Width="60"  TextAlignment="Center" Foreground="#64379F" FontFamily="Inter" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- Academic Record -->
                    <Button Width="80" Height="70" Background="Transparent" BorderThickness="0" Click="Nav_AcademicRecord_Click" Cursor="Hand">
                        <StackPanel HorizontalAlignment="Center">
                            <Grid Width="50" Height="50">
                                <Ellipse Fill="#9854CB" Height="50" Width="50"/>
                                <Image Source="C:\Users\Robin\Downloads\circle-check (1).png" Height="16" Width="26"/>
                            </Grid>

                            <TextBlock Text="Academic Record" FontSize="8" Margin="0,4,0,0" HorizontalAlignment="Center" Width="70"  TextAlignment="Center" Foreground="#64379F" FontFamily="Inter" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- Account Record -->
                    <Button Width="80" Height="60" Background="Transparent" BorderThickness="0" Click="Nav_AccountRecord_Click" Cursor="Hand">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="C:\Users\Robin\Downloads\landmark.png" Height="16" Width="26"/>
                            <TextBlock Text="Account Record" FontSize="8" Margin="0,4,0,0" HorizontalAlignment="Center"  TextWrapping="Wrap" Width="60"  TextAlignment="Center" Foreground="#64379F" FontFamily="Inter" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- Concerns -->
                    <Button Width="80" Height="60"  Background="Transparent" BorderThickness="0"  Click="Nav_Concerns_Click" Cursor="Hand">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="C:\Users\Robin\Downloads\handshake.png" Height="16" Width="26"/>
                            <TextBlock Text="Concerns" FontSize="8" Margin="0,4,0,0" HorizontalAlignment="Center"  TextWrapping="Wrap"  Width="60"  TextAlignment="Center" Foreground="#64379F" FontFamily="Inter" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- Settings -->
                    <Button Width="80" Height="60" Background="Transparent" BorderThickness="0" Click="Nav_Settings_Click" Cursor="Hand">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="C:\Users\Robin\Downloads\settings.png" Height="16" Width="26"/>
                            <TextBlock Text="Settings" FontSize="8" Margin="0,4,0,0" HorizontalAlignment="Center"  TextWrapping="Wrap"  Width="60"  TextAlignment="Center" Foreground="#64379F" FontFamily="Inter" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>


                <!-- “Need Help?” button pinned to bottom -->
                <Button Grid.Row="3" Content="Need Help?" Width="70" Height="25" Background="#E1D2FF" Foreground="#64379F" FontFamily="Inter" FontSize="8" FontWeight="Bold" BorderBrush="Transparent" HorizontalAlignment="Center" Margin="0,0,0,16" Click="Help_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="16" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                </Button>
            </Grid>
        </Border>

        <StackPanel Grid.Column="1" Margin="16">
            <!-- Title -->
            <TextBlock Text="Academic Record"
                 FontFamily="Poppins"
                 FontSize="28"
                 FontWeight="SemiBold"
                 HorizontalAlignment="Center"
                 Margin="0,20,0,20"/>

            <!-- Outer lavender card -->
            <Border Background="#E1D2FF" CornerRadius="12" Padding="16">
                <!-- Inner White Panel -->
                <Border Background="White" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <!-- Header Row -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Subject"    Grid.Column="0" FontWeight="Bold"/>
                            <TextBlock Text="Unit"       Grid.Column="1" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Lab"        Grid.Column="2" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Grid>

                        <!-- Data Rows -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Border Background="#FCFBFF" BorderBrush="#5C4DAA" BorderThickness="2" CornerRadius="8">
                                <ListBox x:Name="lbAcademicRecord"
                                         Background="Transparent"
                                         BorderThickness="0" HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="OverridesDefaultStyle" Value="True"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border Background="{TemplateBinding Background}">
                                                            <ContentPresenter />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>


                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding Subject}"   Grid.Column="0" Margin="5"/>
                                                <TextBlock Text="{Binding Unit}"      Grid.Column="1" Margin="5" TextAlignment="Center"/>
                                                <TextBlock Text="{Binding Lab}"       Grid.Column="2" Margin="5" TextAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Border>
        </StackPanel>


    </Grid>
</Window>
