<Window x:Class="EventDrivenProgEnrollmentSystem.CongratulationsMessage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EventDrivenProgEnrollmentSystem"
        mc:Ignorable="d"
        Title="CongratulationsMessage" Height="400" Width="600" 
        WindowStartupLocation="CenterScreen" Background="#F5F2FF">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Title -->
            <TextBlock Text="Congratulations You Have Enrolled for the Semester/Academic Year!" FontFamily="Poppins" FontSize="36" FontWeight="SemiBold" Foreground="#2D2D2D" TextAlignment="Center" TextWrapping="Wrap" Width="550"/>

            <!-- Emoji + Stars graphic -->
            <!-- Replace the Source paths with your actual image URIs -->
            <Grid Width="120" Height="120">
                <Image Source="C:\Users\Robin\Downloads\enroll.png" Stretch="Uniform"/>
                <StackPanel Orientation="Horizontal"  HorizontalAlignment="Center" VerticalAlignment="Top"  Margin="0,-20,0,0"/>

            </Grid>

            <Button Content="Go to Student Information System" Width="220" Height="40" Margin="0,10,0,0" Background="#A259D1" Foreground="White" FontWeight="SemiBold" FontFamily="Segoe UI" BorderBrush="Transparent" HorizontalAlignment="Center" Cursor="Hand" Click="ButtonTransportHome_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    CornerRadius="20"
                    BorderThickness="0"
                    Padding="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

    </Grid>
</Window>
