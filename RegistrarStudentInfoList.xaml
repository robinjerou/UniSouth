<Window x:Class="EventDrivenProgEnrollmentSystem.RegistrarStudentInfoList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EventDrivenProgEnrollmentSystem"
        mc:Ignorable="d"
        Title="RegistrarStudentInfoList" Height="550" Width="800"
         WindowStartupLocation="CenterScreen">
    <Grid>
        <Rectangle HorizontalAlignment="Left" Height="434" Stroke="Black" VerticalAlignment="Center" Width="106" Fill="#FFB484E2"/>
        <Image Source="C:\Users\Robin\Downloads\unisouthlogo.png" Stretch="Uniform" Margin="-34,8,660,352" RenderTransformOrigin="0.414,0.488"/>
        <Rectangle Height="57" Margin="106,0,0,0" Stroke="Black" VerticalAlignment="Top" Fill="#FF5E2C8E"/>


        <!-- Button with avatar image -->
        <Button HorizontalAlignment="Left" Margin="596,0,0,0" VerticalAlignment="Top" Width="204" Height="57" Background="#FF27104E">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="C:\Users\Robin\Downloads\unisouthlogo.png" Width="55" Height="40"/>
                <TextBlock Foreground="White"><Run Text="JOHN DOE"/><LineBreak/><Run Text="REGISTRAR"/><LineBreak/></TextBlock>
            </StackPanel>
        </Button>

        <Rectangle HorizontalAlignment="Left" Height="440" Stroke="#FF281E58" VerticalAlignment="Top" Width="659" Fill="#FFDDD3E6" Margin="125,90,0,0"/>
        <TextBox HorizontalAlignment="Left" Margin="138,102,0,0" TextWrapping="Wrap" Text="Search..." VerticalAlignment="Top" Width="635" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" 
              Margin="125,125,16,0" 
              Height="250"
              VerticalAlignment="Top">
            <ListView x:Name="StudentListView" FontSize="10" Width="2500" SelectionChanged="StudentListView_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Student ID" Width="150" DisplayMemberBinding="{Binding StudentID}" />
                        <GridViewColumn Header="Name" Width="160" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="Course" Width="150" DisplayMemberBinding="{Binding Course}" />
                        <GridViewColumn Header="Phone" Width="150" DisplayMemberBinding="{Binding Phone}" />
                        <GridViewColumn Header="Address" Width="250" DisplayMemberBinding="{Binding Address}" />
                        <GridViewColumn Header="Email" Width="200" DisplayMemberBinding="{Binding Email}" />
                        <GridViewColumn Header="Birthdate" Width="200" DisplayMemberBinding="{Binding Birthdate}" />
                        <GridViewColumn Header="Gender" Width="200" DisplayMemberBinding="{Binding Gender}" />
                        <GridViewColumn Header="Religion" Width="200" DisplayMemberBinding="{Binding Religion}" />
                        <GridViewColumn Header="Nationality" Width="200" DisplayMemberBinding="{Binding Nationality}" />
                        <GridViewColumn Header="Year Level" Width="200" DisplayMemberBinding="{Binding YearLevel}" />
                        <!--<GridViewColumn Header="Student Status" Width="200" DisplayMemberBinding="{Binding StudentStatus}" />-->
                        <GridViewColumn Header="Username" Width="200" DisplayMemberBinding="{Binding Username}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </ScrollViewer>



        <TextBlock HorizontalAlignment="Left" Margin="200,422,0,0" TextWrapping="Wrap" Text="Email" VerticalAlignment="Top" Width="111"/>
        <TextBox x:Name="txtEmail" HorizontalAlignment="Right" Margin="0,443,400,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="200"/>



        <!--<TextBlock HorizontalAlignment="Left" Margin="518,423,0,0" TextWrapping="Wrap" Text="Student Status" VerticalAlignment="Top" Width="102"/>
        <TextBox x:Name="txtStudentStatus" HorizontalAlignment="Right" Margin="0,443,160,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="122"/>-->

        <TextBlock HorizontalAlignment="Left" Margin="524,422,0,0" TextWrapping="Wrap" Text="Username" VerticalAlignment="Top" Width="102"/>
        <TextBox x:Name="txtUsername" HorizontalAlignment="Right" Margin="0,443,76,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="200"/>

        <Button x:Name="btnUpdateStudent" Content="Update Student"  HorizontalAlignment="Left"  Margin="311,478,0,0" VerticalAlignment="Top" Background="#FF3F22A8"  Foreground="White"  BorderBrush="Transparent"  BorderThickness="1"  Height="36"  Width="134"  FontWeight="Bold" RenderTransformOrigin="0.5,0.5" Click="btnUpdateStudent_Click" >
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="0.337"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}" 
  BorderBrush="{TemplateBinding BorderBrush}" 
  BorderThickness="{TemplateBinding BorderThickness}" 
  CornerRadius="23">
                        <!-- Set CornerRadius here -->
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Button Content="Back"  HorizontalAlignment="Left"  Margin="475,478,0,0" VerticalAlignment="Top" Background="#FF3F22A8"  Foreground="White"  BorderBrush="Transparent"  BorderThickness="1"  Height="36"  Width="134"  FontWeight="Bold" RenderTransformOrigin="0.5,0.5" Click="btnBack_Click" >
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="0.337"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}" 
BorderBrush="{TemplateBinding BorderBrush}" 
BorderThickness="{TemplateBinding BorderThickness}" 
CornerRadius="23">
                        <!-- Set CornerRadius here -->
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

    </Grid>
</Window>
