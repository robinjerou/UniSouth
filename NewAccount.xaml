<Window x:Class="EventDrivenProgEnrollmentSystem.NewAccount"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EventDrivenProgEnrollmentSystem"
        mc:Ignorable="d"
        Title="NewAccount" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid>
        <Border Grid.Row="0" Background="#C7B9FF" CornerRadius="0,0,12,12">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="206*"/>
                    <ColumnDefinition Width="250*"/>
                    <ColumnDefinition Width="299*"/>
                    <ColumnDefinition Width="35*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Image Source="C:\Users\Robin\Downloads\unisouthlogo.png" Stretch="Uniform" Grid.Row="1" Margin="-42,-83,85,73" Grid.ColumnSpan="2"/>
                <Image Source="C:\Users\Robin\Downloads\paint-removebg-preview.png" Stretch="Uniform" Grid.Row="1" Margin="102,5,43,35" RenderTransformOrigin="0.5,0.5" Grid.ColumnSpan="2" Grid.Column="1">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform Angle="-0.018"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>

                <TextBlock Text="UniSouth" FontSize="40" FontWeight="Bold" Foreground="#2D2D2D" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="83,262,0,0" Grid.Row="1" Height="59" Width="212" Grid.ColumnSpan="2"/>
                <TextBlock Text="Enrollment System" FontSize="25" FontWeight="Normal" Foreground="#2D2D2D" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="81,309,0,0" Grid.Row="1" Height="59" Width="216" Grid.ColumnSpan="2"/>

                <Rectangle HorizontalAlignment="Left" Height="113" Margin="122,-65,0,0" Grid.Row="1" Stroke="#393433" StrokeThickness="3" VerticalAlignment="Top" Width="363" 
      RadiusX="20" RadiusY="20" Fill="Transparent" Grid.ColumnSpan="2" Grid.Column="1"/>

                <Rectangle HorizontalAlignment="Left" Height="66" Margin="126,386,0,0" Grid.Row="1" Stroke="Black" StrokeThickness="3" VerticalAlignment="Top" Width="368" 
      RadiusX="20" RadiusY="20" Fill="#714098" Grid.ColumnSpan="2" Grid.Column="1"/>
                <!-- Dark Purple Color -->
                <TextBlock Grid.Column="1" HorizontalAlignment="Left" Margin="214,74,0,0" Grid.Row="1" TextWrapping="Wrap" Text="Welcome!" FontSize="40" VerticalAlignment="Top" RenderTransformOrigin="-0.047,0.525" Grid.ColumnSpan="2"/>
                <TextBlock Grid.Column="1" HorizontalAlignment="Left" Margin="154,126,0,0" Grid.Row="1" TextWrapping="Wrap" Text="Email" FontSize="20" VerticalAlignment="Top" RenderTransformOrigin="-0.047,0.525"/>
                <TextBlock Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="157,204,0,0" Grid.Row="1" TextWrapping="Wrap" Text="Password" FontSize="20" VerticalAlignment="Top" RenderTransformOrigin="-0.047,0.525"/>
                <Rectangle HorizontalAlignment="Left" Height="41" Margin="154,158,0,0" Grid.Row="1" Stroke="#2D2D2D" StrokeThickness="3" VerticalAlignment="Top" Width="311" 
   RadiusX="20" RadiusY="20" Fill="#cdc6d3" Grid.ColumnSpan="2" Grid.Column="1"/>
                <TextBox x:Name="UserEmail" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="172,166,0,0" Grid.Row="1" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="274" Height="33" Background="Transparent" BorderThickness="0"/>
                <Rectangle HorizontalAlignment="Left" Height="41" Margin="154,236,0,0" Grid.Row="1" Stroke="#2D2D2D" StrokeThickness="3" VerticalAlignment="Top" Width="311" 
   RadiusX="20" RadiusY="20" Fill="#cdc6d3" Grid.ColumnSpan="2" Grid.Column="1"/>
                <PasswordBox x:Name="UserPassword" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="173,244,0,0" Grid.Row="1"  VerticalAlignment="Top" Width="274" Height="25" Background="Transparent" BorderThickness="0"/>
                <Button Grid.Column="2" Content="Enter" HorizontalAlignment="Left" Margin="36,309,0,0" Grid.Row="1" VerticalAlignment="Top" Width="51" Background="#FF2B1414" Foreground="#f2ecf7" RenderTransformOrigin="0.588,0.202" FontWeight="Bold" Click="Enter_Click"/>
                <TextBlock Grid.Column="1" HorizontalAlignment="Left" Margin="180,290,0,0" Grid.Row="1" TextWrapping="Wrap" Text="Proceed to an existed account, " VerticalAlignment="Top" Width="180" Grid.ColumnSpan="2"/>
                <Button Grid.Column="2" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Margin="98,287.9,0,0" Grid.Row="1"  Content="click here!" VerticalAlignment="Top" Width="81" Foreground="#812ec8" Background="White" BorderBrush="White" FontWeight="Bold" Click="ClickHere_Button"/>

            </Grid>
        </Border>
    </Grid>
</Window>
